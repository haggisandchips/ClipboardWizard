<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>wizard-hat.ico</ApplicationIcon>
    <!-- Overridden by CI (-p:Version=) from the release tag; this is just the local-dev default. -->
    <Version>1.2.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="wizard-hat.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- ClipboardWizard.Tests lives under this project's own directory, so the default
         SDK globs would otherwise pull its files into this project too. -->
    <Compile Remove="ClipboardWizard.Tests\**" />
    <EmbeddedResource Remove="ClipboardWizard.Tests\**" />
    <None Remove="ClipboardWizard.Tests\**" />
    <Page Remove="ClipboardWizard.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClipboardWizard.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FontAwesome5" Version="2.1.4" />
    <PackageReference Include="MahApps.Metro" Version="2.4.9" />
    <PackageReference Include="SharpClipboard" Version="3.5.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.8.116" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="wizard-hat.ico" />
  </ItemGroup>
</Project>