<mah:MetroWindow x:Class="ClipboardWizard.View.AddCategoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="{Binding Title}"
        MaxWidth="1600"
        MinWidth="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        d:DesignWidth="400" ShowInTaskbar="False" WindowStyle="ToolWindow" Activated="Window_Activated">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="{Binding ActionButtonText}" IsEnabled="{Binding IsValid}" Click="Save_Click" Margin="5" TabIndex="3" IsDefault="True" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="5" TabIndex="4" IsCancel="True" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <Label Content="Name" />
            <TextBox x:Name="NameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" />
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <CheckBox Content="Shared (sync via Firebase)" IsChecked="{Binding Shared, Mode=TwoWay}" Margin="0 10 0 0" TabIndex="2" />
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsFirebaseSetup}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <fa5:FontAwesome Icon="Solid_ExclamationTriangle" Foreground="OrangeRed" VerticalAlignment="Center" Margin="0 0 6 0" />
                    <TextBlock Text="Firebase isn't set up or connected yet - this category won't sync until it is." TextWrapping="Wrap" Foreground="OrangeRed" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</mah:MetroWindow>
