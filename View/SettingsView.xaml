<mah:MetroWindow x:Class="ClipboardWizard.View.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="Firebase Settings"
        MaxWidth="1600"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        d:DesignWidth="500" ShowInTaskbar="False" WindowStyle="ToolWindow" Activated="Window_Activated">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Save" IsEnabled="{Binding IsValid}" Click="Save_Click" Margin="5" TabIndex="3" IsDefault="True" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="5" TabIndex="4" IsCancel="True" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0 0 0 10">
                Paste or browse to a GCP service-account key (downloaded from the Firebase/GCP
                console) to enable syncing Shared categories via Firestore. Scope the service
                account to only the Firestore/Datastore User IAM role, and treat this key like a
                password - it grants full access to your Firestore database.
            </TextBlock>
            <DockPanel Margin="0 0 0 4">
                <Label Content="Service account key (JSON)" DockPanel.Dock="Left" Padding="0" VerticalAlignment="Center" />
                <Button Content="Browse..." Click="Browse_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10 2" />
            </DockPanel>
            <TextBox x:Name="ServiceAccountJsonTextBox"
                     Text="{Binding ServiceAccountJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     Height="160"
                     FontFamily="Consolas"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TabIndex="1" />
            <TextBlock Margin="0 4 0 0" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Project id: (paste a valid key to see it)" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                <Setter Property="Text" Value="{Binding ProjectId, StringFormat='Project id: {0}'}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DockPanel Margin="0 12 0 0">
                <Button Content="Test Connection" Click="TestConnection_Click" IsEnabled="{Binding IsValid}" DockPanel.Dock="Left" Padding="10 4" TabIndex="2" />
                <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TestResultMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Firebrick" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastTestSucceeded}" Value="True">
                                    <Setter Property="Foreground" Value="DarkGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</mah:MetroWindow>
