<Window x:Class="ClipboardWizard.View.WizardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClipboardWizard.ViewModel"
        xmlns:uc="clr-namespace:ClipboardWizard.View.Control"
        mc:Ignorable="d"
        Title="Clipboard Wizard" Height="450" Width="800" MinWidth="200">

    <Window.Resources>
        <vm:WizardViewModel x:Key="vm" />
    </Window.Resources>

    <ScrollViewer DataContext="{StaticResource vm}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
        <ItemsControl ItemsSource="{Binding Snippets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid x:Name="SnippetsUniformGrid"
                                 VerticalAlignment="Top"
                                 Loaded="SnippetsUniformGrid_Loaded"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <uc:SnippetControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
   
</Window>
