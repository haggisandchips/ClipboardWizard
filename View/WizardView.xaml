<mah:MetroWindow x:Class="ClipboardWizard.View.WizardView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:fa5="http://schemas.fontawesome.com/icons/"
                 xmlns:uc="clr-namespace:ClipboardWizard.View.Control"
                 mc:Ignorable="d"
                 Title="Clipboard Wizard"
                 Height="450"
                 Width="800"
                 MinWidth="200">

    <!-- Font Awesome Free Solid "hat-wizard" (fa-hat-wizard), rendered live rather than as a
         bundled image - CC BY 4.0, via the FontAwesome5 package this project already
         depends on. See THIRD-PARTY-NOTICES.md. -->
    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <Grid Width="{TemplateBinding Width}"
                 Height="{TemplateBinding Height}"
                 Background="Transparent"
                 RenderOptions.EdgeMode="Aliased"
                 RenderOptions.BitmapScalingMode="HighQuality">
                <!-- fa5:FontAwesome derives from TextBlock, so its size comes from FontSize
                     (not Width/Height) and it needs explicit centering - TextBlock doesn't
                     center its own content within extra space the way most controls do. -->
                <fa5:FontAwesome Icon="Solid_HatWizard"
                                  Foreground="White"
                                  FontSize="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>
    
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands x:Name="RightWindowCommandsHost">
            <mah:ToggleSwitch  OnContent="Recording ON" OffContent="Recording OFF" IsOn="{Binding Recording, Mode=TwoWay}" Foreground="White" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="5">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding SaveClipboardContents}" Focusable="False">
                    <fa5:FontAwesome Icon="Solid_Plus" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddCategory}" Focusable="False" Content="New Category" Margin="0 0 5 0" />
                <Button Command="{Binding AddSnippet}" Focusable="False" Content="New Snippet" />
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="5">
            <!-- One shared host for the whole accordion: both category-row reordering and
                 snippet drag/drop (reorder within a section, or drag onto another section to
                 recategorize) route through this single Grid's handlers, branching on the drag
                 payload's format, rather than each CategorySectionControl/SnippetControl
                 tracking its own drop target - see CategorySectionControl's XAML comment. -->
            <Grid AllowDrop="True"
                  DragOver="AccordionHost_DragOver"
                  DragLeave="AccordionHost_DragLeave"
                  Drop="AccordionHost_Drop">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:CategorySectionControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Always last, and not part of the reorderable ItemsControl above -
                             see WizardViewModel.UncategorizedSection. -->
                        <uc:CategorySectionControl DataContext="{Binding UncategorizedSection}" />
                    </StackPanel>
                </ScrollViewer>
                <!-- Vertical bar: which side of a snippet tile a dragged snippet will land on. -->
                <Canvas x:Name="SnippetIndicatorCanvas" IsHitTestVisible="False">
                    <Border x:Name="SnippetDropIndicator"
                            Width="4"
                            Background="DodgerBlue"
                            Visibility="Collapsed" />
                </Canvas>
                <!-- Horizontal bar: same idea, for a dragged category row - above/below the
                     hovered section instead of left/right of a tile. -->
                <Canvas x:Name="CategoryIndicatorCanvas" IsHitTestVisible="False">
                    <Border x:Name="CategoryDropIndicator"
                            Height="3"
                            Background="DodgerBlue"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </DockPanel>
    </DockPanel>

</mah:MetroWindow>
