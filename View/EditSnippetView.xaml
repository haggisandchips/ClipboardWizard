<mah:MetroWindow x:Class="ClipboardWizard.View.EditSnippetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:ctrl="clr-namespace:ClipboardWizard.View.Control"
        mc:Ignorable="d"
        Title="{Binding Title}"
        MaxHeight="800"
        MaxWidth="1600"
        MinWidth="300"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        d:DesignWidth="600"
        d:DesignHeight="400" ShowInTaskbar="False" WindowStyle="ToolWindow" Activated="Window_Activated">

    <mah:MetroWindow.Resources>
        <ctrl:ImageBytesConverter x:Key="imageConverter"/>
    </mah:MetroWindow.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0 0 0 10">
            <Label Content="Description" />
            <TextBox x:Name="DescriptionTextBox" Text="{Binding Description, Mode=TwoWay}" TabIndex="1" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding ActionButtonText}" IsEnabled="{Binding IsValid}" Click="Update_Click" Margin="5" TabIndex="3" IsDefault="True" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="5" TabIndex="4" IsCancel="True" />
        </StackPanel>
        <DockPanel>
            <Label DockPanel.Dock="Top" Content="Content" />
            <Grid>
                <TextBox x:Name="ContentTextBox"
                         Text="{Binding Content, Mode=TwoWay}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" TabIndex="2">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!-- Image content is never editable here, only previewed: there's no
                     sensible way to "retype" a picture's pixels. It's auto-sized (Stretch=
                     Uniform inside a layout container, not a fixed size) so it scales as the
                     user resizes this window. -->
                <Border Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="Image">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding ImageData, Converter={StaticResource imageConverter}}"
                           Stretch="Uniform" Margin="4" />
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</mah:MetroWindow>
